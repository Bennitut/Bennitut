# FoodTracker-Server: Einstellungen zum Testen auf dem eigenen Rechner.
#
# So geht's: Diese Datei im selben Ordner als ".env" speichern (start-test.cmd macht das beim ersten Start
# selbst) und bei Bedarf anpassen. Die .env wird nie eingecheckt (steht in .gitignore) – Schlüssel gehören
# dorthin, nie in diese Vorlage. Zeilen mit # sind Kommentare; zum Einschalten das # am Zeilenanfang löschen.
# Nach Änderungen den Server neu starten. Schon gesetzte Umgebungsvariablen gewinnen gegenüber der Datei.

# ---------------------------------------------------------------------------------------------------------
# Netzwerk
# ---------------------------------------------------------------------------------------------------------

# Port des Servers. Die App sucht ihn auf dem Rechner, auf dem Expo läuft, unter Port 3000.
PORT=3000

# Websites, die den Server aus dem Browser nutzen dürfen (CORS), kommagetrennt. Immer erlaubt sind
# localhost, 127.0.0.1 und Adressen im eigenen Netz (10.x, 172.16–31.x, 192.168.x) mit beliebigem Port.
# CORS_ORIGINS=https://bennitut.github.io

# Nur hinter einem Proxy (Cloudflare Tunnel, Render …): die IP-Adresse für das Rate-Limit bei der Anmeldung aus dessen
# Header nehmen. Ohne Proxy weglassen – sonst kann jede:r eine beliebige Adresse vorgeben.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------------------------------------
# KI für Foto- und Bon-Erkennung, Rezept-Import, Übersetzen, „Text verbessern“ und KI-Wünsche im Plan
# ---------------------------------------------------------------------------------------------------------

# claude oder ollama. Ohne Angabe: Claude, wenn ANTHROPIC_API_KEY gesetzt ist, sonst Ollama, wenn es läuft.
# AI_PROVIDER=ollama

# Claude von Anthropic – kostet API-Guthaben (nicht im Claude-Abo enthalten): https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Ollama – kostenlos und Open Source, läuft auf diesem Rechner (https://ollama.com):
#   winget install Ollama.Ollama
#   ollama pull gemma4:e4b
# Das Modell muss Bilder verstehen (Foto, Kassenbon, Video-Import). Alternative: qwen3-vl:8b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
# Kontextlänge in Tokens (mehr braucht mehr Grafikspeicher; Standard 16384).
# OLLAMA_NUM_CTX=16384
# Zeitlimit pro KI-Anfrage in Sekunden (Standard 240, höchstens 300). Lokal dauern Antworten oft 20–90 Sekunden,
# die erste länger, weil Ollama das Modell lädt.
# OLLAMA_TIMEOUT_SECONDS=240

# ---------------------------------------------------------------------------------------------------------
# Instagram (optional)
# ---------------------------------------------------------------------------------------------------------

# Instagram gibt Beschreibungen ohne Anmeldung oft nicht heraus – dann die Caption beim Import ins Feld
# „Beschreibung“ kopieren. Mit einem Token einer Meta-App (APP_ID|CLIENT_TOKEN) klappt es über oEmbed öfter.
# META_OEMBED_TOKEN=

# ---------------------------------------------------------------------------------------------------------
# Anmeldung
# ---------------------------------------------------------------------------------------------------------

# Anmeldung nur mit einem Namen, ohne Apple oder Google – NUR ZUM TESTEN im eigenen WLAN, nie auf einem Server
# im Internet: Damit kann sich jede:r im WLAN unter jedem Namen anmelden, mit einer E-Mail aus ADMIN_EMAILS
# sogar als Admin. Zum Ausschalten die Zeile löschen.
ALLOW_DEV_LOGIN=1

# Diese E-Mail-Adressen werden beim Anmelden automatisch Admin (kommagetrennt).
# ADMIN_EMAILS=

# „Mit Apple anmelden“: Bundle-IDs (in Expo Go: host.exp.Exponent). „Mit Google anmelden“: OAuth-Client-IDs.
# APPLE_BUNDLE_IDS=host.exp.Exponent
# GOOGLE_CLIENT_IDS=

# Konten mit E-Mail und Passwort gehen immer (Passwort mindestens 10 Zeichen). Zum Admin über ADMIN_EMAILS wird ein
# solches Konto erst mit bestätigter Adresse – bisher durch einmal „Passwort vergessen?“ (braucht die E-Mail unten).

# ---------------------------------------------------------------------------------------------------------
# E-Mail (optional) – nur für „Passwort vergessen?“: Der Server schickt einen Code, der 30 Minuten gilt.
# Ohne SMTP_HOST und SMTP_FROM blendet die App den Knopf aus.
# ---------------------------------------------------------------------------------------------------------

# Zugangsdaten eines Mail-Kontos mit SMTP, z. B. Gmail mit einem App-Passwort (Google-Konto → Sicherheit →
# Bestätigung in zwei Schritten → App-Passwörter): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=deine Adresse.
# SMTP_HOST=
# Port 587 (STARTTLS, Standard) oder 465 (TLS von Anfang an).
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Absender, z. B.: FoodTracker <deine.adresse@gmail.com>
# SMTP_FROM=

# ---------------------------------------------------------------------------------------------------------
# Dateien (relativ zum Ordner server/, landen unter server/data/ und werden nicht eingecheckt)
# ---------------------------------------------------------------------------------------------------------

# COMMUNITY_FILE=data/community.json
# FEEDBACK_FILE=data/feedback.json
# USERS_FILE=data/users.json
# OVERRIDES_FILE=data/recipe-overrides.json
# Sicherung der Ernährungshistorie: eine Datei pro Konto bzw. Gerät.
# DIARY_DIR=data/diary
