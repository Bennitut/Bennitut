{
  "name": "foodtracker-server",
  "version": "1.0.0",
  "description": "Backend für FoodTracker: Foto-/Rechnungserkennung, Zero-Waste-Ernährungsplanung, Lieferdienst-Anbindung",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
